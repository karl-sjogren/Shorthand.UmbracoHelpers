<Project>
  <PropertyGroup>
    <!-- Solution settings -->
    <UmbracoMajorVersion Condition="'$(UmbracoMajorVersion)' == ''">18</UmbracoMajorVersion>
    <Version Condition="'$(UmbracoMajorVersion)' == '17'">17.0.0</Version>
    <Version Condition="'$(UmbracoMajorVersion)' == '18'">18.0.1</Version>
    <Version Condition="'$(UmbracoMajorVersion)' == '19'">19.0.0-rc1</Version>
    <DefineConstants>$(DefineConstants);UMBRACO_$(UmbracoMajorVersion)</DefineConstants>
    <LangVersion>latest</LangVersion>
    <TargetFramework Condition="'$(UmbracoMajorVersion)' != '19'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(UmbracoMajorVersion)' == '19'">net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>565c02a2-138c-4deb-9969-d4e03dae90a8</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Build configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors> <!-- A package restored for your project has a known vulnerability. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;NU1902;NU1903</NoWarn>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths Condition="'$(TF_BUILD)' == 'True' Or '$(CI)' == 'true'">true</DeterministicSourcePaths>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package restore configuration -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- This doesn't currently work with dependabot, see https://github.com/dependabot/dependabot-core/issues/10863 -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(TF_BUILD)' == 'True' Or '$(CI)' == 'true'">false</RestoreLockedMode>
  </PropertyGroup>

</Project>
